#include<stdio.h>

void swap(int*x,int*y){
	int t=*x;
	*x=*y;
	*y=t;
}//哈哈注意程序执行步骤！swap要在它被调用前声明否则后面不认识！！！哈哈！约科实！！MARX!!

void quicksort(int a[],int left,int right){//传入了数组名就是传入了，数组的首地址！
	//递归首先考虑终止条件：如果left>=right，直接return，我们后续调用它时，要正确传入参数！健壮性完善也是递归终止条件哈哈
	if(left>=right) return;//双边界指针交汇的那一刻，就实现了遍历
	//说明数据已被遍历穷举了，这就是实质与核心！后面科学的设计是为了高效！！哈哈MARX意义！！！MARX意义！！！MARX意义！！
	//选基准值（一定要选中间的或随机的！否则数据大则容易超时！）
	int mid=a[(left+right)/2];//就选中间的，反正此时数组成员是乱序的，我们就是要让计算机来帮我们排序，反正会遍历穷举
	//定义双指针
	int i=left,j=right;//简化哈哈！
	//核心循环：while(i<=j)
	while(i<=j){
		//左边找一个>=mid的
		while(a[i]<mid) i++;
		//右边找一个<=mid的
		while(a[j]>mid) j--;//注意是j--,i是初始化为'最左边'的下标，j是初始化为'最右边'的下标！！
		//因为我们的排序小的在左边，现在在排序，所以把左边大于中间的找出来，即把不符合排序的找出来！二分法豪用！豪工具！！
		if(i<=j){//说明找到了两边需要交换的数，因为从上面双方各自的循环中跳了出来，程序执行顺序！！&正确理解代码表意！！
			//还有注意，做指针i的循环是在右指针j的循环前面的，重点：前面循环里的等号不能取！如果说它是完全有序的，那跳出上面的循环时，就是i，j都等于mid
			//等于也直接交换一下，各自越过，刚好卡住正确边界，提高效率~
			//关于等号不能取，例如当左半边都小于mid时，i跳出来就是mid，j跳出来不是，那我们需要的顺序，也就是要换，[0,3,1],如果取等号，
			//等于mid不会跳，那i一直加，跳不出来，i跳不出来，j就跳不出来，而j明明要跳的，错误，
			//所以跳出来，只要位置i<=j,就是较大的在左边了，我们的顺序，大的要在右边，所以只要i<=j就要换，初步排序...
			swap(&a[i],&a[j]);
			i++;
			j--;//循环控制变量！值相应变化进入下一轮循环！！做完交换了，就完成了，就开始下一个了嘛~正确性&效率
		}
	}
	//递归左边和右边,上一步的基准值mid的数值并非正好就是中位数，但是位置的中位，排序也相应完成一部分，这就是递归大问题变成多个相同的小问题
	quicksort(a,left,j);//定义的变量在作用域内生效，且是我们需要的数据！！key！！别搞错！！
	quicksort(a,i,right);//嗯~左右开弓 
	//left和right,就是真正实际上的最左和最右！！就是我们一开始传入的参数，所以这样分，确保穷举遍历，确保正确性，要完全有序，就是要完全扫一边，
	//试想结束时，原本的j=left了，原本的i=right了，每一个位置都被指过（做相应的实现顺序交换操作），并一次一次地缩小范围，到了必然正确的只有两个数之间的大小排序层面
	//并且...这样穷举...,所以实现了算法正确性，让我想到了冒泡排序，难怪有超时风险
	//递归的参数位置，算法的正确性是不能写错的！

	//以后学习算法都要推演追踪数据变化！这是key!!这样才能真正理解对应具体感受！！抓住实质与核心！！这才是key!!才是高阶！才是主矛！！才是事物的主矛！
	//主矛主要、主导影响！！有它才能更好地改造世界！！而这意义！！MARX！！意义！！最好！！意义！！
}



int main(){
	int n;
	scanf("%d",&n);
	int a[100005];
	for(int i=0;i<n;i++){
	scanf("%d",&a[i]);
	}
	quicksort(a,0,n-1);//名字里不能包含减号！约科实！
	for(int i=0;i<n;i++){
		printf("%d ",a[i]);
	}
	return 0;
}
