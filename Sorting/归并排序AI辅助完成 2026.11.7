#include<stdio.h>
#define MAX 100

void mergeSort(int a[],int left,int right){
	if(left>=right) return;
	int mid=(left+right)/2;
	int temp[MAX];
	int i=left;//“指向”左边那一半的开头（以后这种语境的指向指针就不再特别说明了，见了这么多次了，就是这个意思，也该记住了）
	int j=mid+1;//指向右边那一半的开头
		mergeSort(a,left,mid);//数组名包含首地址，约科实，所以递归修改跨域存在！左半边，继续排序，
		mergeSort(a,mid+1,right);//看设计，就是不断地把小的往左边放哈哈，右半边继续排序
		//这里就直接递归调用，归并排序，分治思想 嗯~ 
		//所以一直分，分到终止条件才会进行下面的步骤了，程序执行顺序！
	int k=0;//指向临时数组 temp 的开头
	while(i<=mid&&j<=right){//分治，分而治之，分开两半，自有各自的边界，感性材料，客观事实
		if(a[i]<=a[j]){
			temp[k++]=a[i++];
		}
		else {
			temp[k++]=a[j++];
		}
		
		}
		//上面的循环结束时，肯定有一边空了，另一边还有剩 哈哈~归并排序，小的先入临时数组，看我们的设计等于也是左半边先入，左右半边个数相当 ，
		//额，再说极端情况，总会有一个最大值，在哪边，哪边就清空不了的，所以总有一边先清空，另一边还剩 
		while(i<=mid){//如果左边还有剩，剩下的全部塞入temp
			temp[k++]=a[i++];//注意我们变量变化的设计哦~
		}
		while(j<=right){//如果右边还有剩，剩下的全部塞入temp
			temp[k++]=a[j++];//两个while，双保险哈哈~ 剩的大的都是直接放在右边的！！
		}
		
		//现在temp里面已经基本有序，把数据，再依次放回a[left]和a[right]里面
		for(int x=0;x<k;x++){
			a[left+x]=temp[x];//直接说放回数组a里面不就够了，嗯~ left+x 没什么就是一次嘛，利用结合循环变量实现，我直接a[x]=temp[x] 也行！不！还要考虑后续的递归调用！
		}
		//全部放回来进行递归调用哈哈~
		//较小的都在左半边了，较大的都在右半边，直接分而治之，直接弱化两半边的联系，弱化之间矛盾冲突，便安分各自，客观物质的看，数量减少了，这个物质，哈哈自然就轻松容易了！
		//再回看最后一步的数据放回数组a ，就是把数据，再依次放回a[left]和a[right]里面
		
}



int main(){
	int a[]={8,3,5,1,9,2};
		mergeSort(a,0,5);
	//这里来解析算法
	/*
传入参数后，mid=2,i=0,j=3 然后进入递归调用 (a,0,2)
然后继续，先(a,0,2)，mid=1,i=0,j=2, 递归调用（a,0,1)程序执行顺序！
先执行(a,0,1)  mid=0,i=0,j=1,递归调用(a,0,0),(a,1,1),欧克，两个都直接终止条件，回到(a,0,1) 继续执行剩下的步骤， 
 
 OK，上面太抽象，太繁琐，低效了（哈哈，本来就是次矛对于我们期望的矛盾运动是次要影响，当然慢，不是决定性作用，力量小！！），我们应该着重于主矛，
看，所以我们着重来分析一下数据的运动，就是分治，分到简单到无需再分，或不可再分为止，、
哈哈，使每一个部分都是精确有序的，我们再来一步步合，看算法的临时数组部分操作，就是把较小的都放在左边了，每一个部分都是正确排序的了
所以当两个同级部分合并时，首先临时数组的准入处理，你看第一次循环就是在比较两个部分各自最小的成员，最小的先入，就保证了整体上的排序正确性哈哈！
一个部分的最小是两个同级部分这个整体上的最小，先入了，然后没入的部分最小和另一部分次小比较...,最后还有剩的就直接按自身顺序全部入就是了，
它自己本身就是有序的！
部分有序，级级回溯，通过有序比较合并，得到的就是一个有序的整体!（你所能看到的客观事实！）（把客观事实，物质根源表述清楚，语言本质就是对应客观物质的符号，当然能做到，最好！MARX意义！！）
